 263:Core/Src/app_modbus_u2.c ****       U2LOGI("[MODBUS-U2]   %s(0x%04X) = %ld\r\n",
 264:Core/Src/app_modbus_u2.c ****             meta->name,
 265:Core/Src/app_modbus_u2.c ****             (unsigned int)addr,
