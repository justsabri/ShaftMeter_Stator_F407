 271:Core/Src/app_modbus_u2.c ****       memcpy(&f32, &u32, sizeof(f32));
 272:Core/Src/app_modbus_u2.c ****       U2LOGI("[MODBUS-U2]   %s(0x%04X) = %.*f\r\n",
 273:Core/Src/app_modbus_u2.c ****             meta->name,
 274:Core/Src/app_modbus_u2.c ****             (unsigned int)addr,
 275:Core/Src/app_modbus_u2.c ****             (int)meta->decimals,
