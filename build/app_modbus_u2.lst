 281:Core/Src/app_modbus_u2.c **** static uint16_t AppModbusU2_BuildWriteMultiple(const app_modbus_u2_ctx_t *ctx,
 282:Core/Src/app_modbus_u2.c ****                                                uint16_t start_addr,
 283:Core/Src/app_modbus_u2.c ****                                                uint16_t quantity,
 284:Core/Src/app_modbus_u2.c ****                                                const uint16_t *regs,
 285:Core/Src/app_modbus_u2.c ****                                                uint8_t *out,
 286:Core/Src/app_modbus_u2.c ****                                                uint16_t out_size)
 287:Core/Src/app_modbus_u2.c **** {
 288:Core/Src/app_modbus_u2.c ****   uint16_t i;
 289:Core/Src/app_modbus_u2.c ****   uint16_t crc;
 290:Core/Src/app_modbus_u2.c ****   uint16_t data_bytes;
 291:Core/Src/app_modbus_u2.c **** 
 292:Core/Src/app_modbus_u2.c ****   if ((ctx == NULL) || (regs == NULL) || (out == NULL))
 293:Core/Src/app_modbus_u2.c ****   {
 294:Core/Src/app_modbus_u2.c ****     return 0U;
 295:Core/Src/app_modbus_u2.c ****   }
 296:Core/Src/app_modbus_u2.c **** 
 297:Core/Src/app_modbus_u2.c ****   data_bytes = (uint16_t)(quantity * 2U);
 298:Core/Src/app_modbus_u2.c ****   if (quantity == 0U)
 299:Core/Src/app_modbus_u2.c ****   {
 300:Core/Src/app_modbus_u2.c ****     return 0U;
 301:Core/Src/app_modbus_u2.c ****   }
 302:Core/Src/app_modbus_u2.c ****   if (out_size < (uint16_t)(9U + data_bytes))
 303:Core/Src/app_modbus_u2.c ****   {
 304:Core/Src/app_modbus_u2.c ****     return 0U;
 305:Core/Src/app_modbus_u2.c ****   }
 306:Core/Src/app_modbus_u2.c **** 
 307:Core/Src/app_modbus_u2.c ****   out[0] = ctx->slave_id;
 308:Core/Src/app_modbus_u2.c ****   out[1] = 0x10U;
 309:Core/Src/app_modbus_u2.c ****   out[2] = (uint8_t)(start_addr >> 8);
 310:Core/Src/app_modbus_u2.c ****   out[3] = (uint8_t)(start_addr & 0xFFU);
 311:Core/Src/app_modbus_u2.c ****   out[4] = (uint8_t)(quantity >> 8);
 312:Core/Src/app_modbus_u2.c ****   out[5] = (uint8_t)(quantity & 0xFFU);
 313:Core/Src/app_modbus_u2.c ****   out[6] = (uint8_t)data_bytes;
 314:Core/Src/app_modbus_u2.c ****   for (i = 0U; i < quantity; i++)
 315:Core/Src/app_modbus_u2.c ****   {
 316:Core/Src/app_modbus_u2.c ****     out[7U + (2U * i)] = (uint8_t)(regs[i] >> 8);
 317:Core/Src/app_modbus_u2.c ****     out[8U + (2U * i)] = (uint8_t)(regs[i] & 0xFFU);
 318:Core/Src/app_modbus_u2.c ****   }
 319:Core/Src/app_modbus_u2.c **** 
 320:Core/Src/app_modbus_u2.c ****   crc = ModbusMaster_Crc16(out, (uint16_t)(7U + data_bytes));
 321:Core/Src/app_modbus_u2.c ****   out[7U + data_bytes] = (uint8_t)(crc & 0xFFU);
 322:Core/Src/app_modbus_u2.c ****   out[8U + data_bytes] = (uint8_t)(crc >> 8);
 323:Core/Src/app_modbus_u2.c ****   return (uint16_t)(9U + data_bytes);
 324:Core/Src/app_modbus_u2.c **** }
