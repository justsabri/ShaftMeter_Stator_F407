 352:Core/Src/app_modbus_u2.c **** 
 353:Core/Src/app_modbus_u2.c ****     crc_calc = ModbusMaster_Crc16(&buf[i], 6U);
 354:Core/Src/app_modbus_u2.c ****     crc_rx = (uint16_t)buf[i + 6U] | ((uint16_t)buf[i + 7U] << 8);
