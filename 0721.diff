+/* 格式化并通过调试串口整包输出，避免 printf 被优化成 puts 后单步误判。 */
+void AppDebug_Log(const char *fmt, ...)
+{
+#if DEBUG_UART_ENABLE
+  char buf[DEBUG_UART_LOG_BUF_SIZE];
+  va_list args;
+  int len;
+#if DEBUG_UART_USE_RS485_DIR
+  uint32_t start_tick;
+#endif
+
+  if (fmt == NULL)
+  {
+    return;
+  }
+
+  va_start(args, fmt);
+  len = vsnprintf(buf, sizeof(buf), fmt, args);
+  va_end(args);
+
+  if (len <= 0)
+  {
+    return;
+  }
+  if ((uint32_t)len >= sizeof(buf))
+  {
+    len = (int)sizeof(buf) - 1;
+  }
+
+#if DEBUG_UART_USE_RS485_DIR
+  AppTxResult_SetRs485Usart6(1U);
+#endif
+  (void)HAL_UART_Transmit(&huart6, (uint8_t *)buf, (uint16_t)len, DEBUG_UART_TX_TIMEOUT_MS);
+#if DEBUG_UART_USE_RS485_DIR
+  start_tick = HAL_GetTick();
+  while (__HAL_UART_GET_FLAG(&huart6, UART_FLAG_TC) == RESET)
+  {
+    if ((HAL_GetTick() - start_tick) > DEBUG_UART_TX_TIMEOUT_MS)
+    {
+      break;
+    }
+  }
+  AppTxResult_SetRs485Usart6(0U);
+#endif
+#else
+  (void)fmt;
+#endif
+}
